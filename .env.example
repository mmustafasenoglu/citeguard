# LLM provider selection (optional).
# Supported: anthropic, openai, xai, groq, openrouter, nvidia, custom
# When omitted, auto-detected from available API keys.
# CITEGUARD_LLM_PROVIDER=anthropic

# LLM model override (optional, provider-specific default used when omitted).
# CITEGUARD_LLM_MODEL=claude-sonnet-4-20250514

# Anthropic (default provider)
# ANTHROPIC_API_KEY=

# OpenAI (Responses API)
# OPENAI_API_KEY=

# xAI / Grok (Responses API)
# XAI_API_KEY=

# Groq (OpenAI-compatible)
# GROQ_API_KEY=

# OpenRouter (OpenAI-compatible)
# OPENROUTER_API_KEY=

# NVIDIA NIM (OpenAI-compatible)
# NVIDIA_API_KEY=

# Custom / local endpoint (Ollama, LM Studio, vLLM, LiteLLM, etc.)
# CITEGUARD_LLM_BASE_URL=http://localhost:11434/v1
# CITEGUARD_LLM_API_KEY=local
# CITEGUARD_LLM_MODEL=qwen3

# Academic providers
# Optional. citeguard can use Semantic Scholar without a key, subject to public limits.
# SEMANTIC_SCHOLAR_API_KEY=
